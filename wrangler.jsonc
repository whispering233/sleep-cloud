{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sleep-cloud",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
