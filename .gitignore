node_modules/
.wrangler/
dist/

# 密钥与本地变量：绝不入库（wrangler dev 会读 .dev.vars 与 .env）
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example

# 本机专属的 wrangler 配置：多一条带 zone 名的生产入口路由（zone 不公开）
wrangler.local.jsonc

# 本机专属的 Android SDK 路径（含 Windows 用户名，见 .android-env.example 与 docs/design/build.md §7）
.android-env

# 构建生成物（`npm run tokens` 从 docs/ui/DESIGN.md 导出，CSS 与 JSON 两份）
src/client/styles/tokens.css
src/client/styles/tokens.json

# 测试缓存（vitest 每次跑测试都会写）
.vitest/

# 测试与覆盖率
coverage/
.nyc_output/

# Playwright 的测试产物（`npm run e2e` 每次都会写）
test-results/
playwright-report/

# 类型缓存
*.tsbuildinfo

# 本地数据库副本（真源在 .wrangler/ 下，这里防把手工导出的库文件入库）
*.sqlite
*.sqlite-shm
*.sqlite-wal

# 工程导出的临时数据（例如本地脚本 dump 出来的）
*.tmp.json

# 编辑器与系统垃圾（这台机器是 WSL，Windows 宿主也会往挂载目录里丢东西）
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# 日志
*.log
