# 本机专用：复制成 .android-env 再改路径（.android-env 不进仓库，与 .dev.vars 同一套习惯）。
#
# 为什么需要这个文件：Android SDK 装在**宿主 Windows** 上（模拟器要用宿主 GPU，理由见
# docs/design/build.md §7「Android 模拟器」），而项目跑在 WSL 里。SDK 的真实路径含 Windows
# 用户名，不能写进文档也不能入库，所以由这个本地文件提供。
#
# 用法：在要起模拟器 / 连 adb 的那一层 shell 里 source 一次
#   . ./.android-env

# 宿主 Android SDK 的位置。Windows 上的默认安装点是 %LOCALAPPDATA%\Android\Sdk，
# 在 WSL 里读作 /mnt/c/Users/<你的 Windows 用户名>/AppData/Local/Android/Sdk
export ANDROID_HOME="/mnt/c/Users/<你的 Windows 用户名>/AppData/Local/Android/Sdk"

# 宿主的可执行文件（是 .exe，不是 WSL 里的 Linux 版；WSL 里不要另装一份 SDK）
export ADB="$ANDROID_HOME/platform-tools/adb.exe"
export EMULATOR="$ANDROID_HOME/emulator/emulator.exe"

# 要用的 AVD 名字（`"$EMULATOR" -list-avds` 列出来挑一个）
export AVD_NAME="Medium_Phone"
