{
  "name": "sleep-cloud",
  "version": "0.0.6",
  "private": true,
  "type": "module",
  "description": "跑在 Cloudflare 上的线上睡眠大厅",
  "scripts": {
    "tokens": "design.md export docs/ui/DESIGN.md --format css-tailwind > src/client/styles/tokens.css && design.md export docs/ui/DESIGN.md --format json-tailwind > src/client/styles/tokens.json",
    "lint:design": "design.md lint docs/ui/DESIGN.md",
    "art": "node tools/art/build-sprites.mjs",
    "build": "npm run tokens && vite build",
    "dev": "node tools/dev/dev.mjs",
    "dev:web": "npm run tokens && vite",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "deploy": "npm run build && wrangler deploy --config wrangler.local.jsonc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whispering233/sleep-cloud.git"
  },
  "license": "MIT",
  "dependencies": {
    "hono": "^4.13.13",
    "phaser": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@google/design.md": "^0.4.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
